// Windows resources for the GUI: the exe icon plus the version metadata
// Explorer shows in Properties. Generated by CMake from
// build/windows/info.json and build/windows/icon.ico; a release bump edits
// info.json (see RELEASE.md). The backend exe carries no resources — it is
// an internal sidecar, never distributed on its own.
#include <windows.h>

// The lowest-numbered icon resource is the one Explorer and the taskbar use.
IDI_ICON1 ICON "@MYBENCH_ICON@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @MYBENCH_VERSION_COMMAS@
PRODUCTVERSION @MYBENCH_VERSION_COMMAS@
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0" // US English, Unicode
        BEGIN
            VALUE "CompanyName", "@MYBENCH_COMPANY@"
            VALUE "FileDescription", "@MYBENCH_DESCRIPTION@"
            VALUE "FileVersion", "@MYBENCH_VERSION@"
            VALUE "InternalName", "mybench"
            VALUE "LegalCopyright", "@MYBENCH_COPYRIGHT@"
            VALUE "OriginalFilename", "mybench.exe"
            VALUE "ProductName", "@MYBENCH_PRODUCT@"
            VALUE "ProductVersion", "@MYBENCH_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
